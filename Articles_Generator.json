    {
      "parameters": {
        "jsCode": "// Assuming docId is already retrieved via Google Docs: Create Document\nconst docId = $input.first().json.id;\n\nconst title = $('Google Sheets').first().json.Title || 'Untitled';\nconst description = $('Google Sheets').first().json.Description || '';\nconst article = $('Basic LLM Chain').first().json.output.Article || '';\n\nconst requests = [];\n\n// Start from index 1 (Docs API starts at 1)\nlet cursor = 1;\n\n// Insert Title\nrequests.push({\n  insertText: {\n    location: { index: cursor },\n    text: title + '\\n'\n  }\n});\nrequests.push({\n  updateParagraphStyle: {\n    range: {\n      startIndex: cursor,\n      endIndex: cursor + title.length + 1,\n    },\n    paragraphStyle: { namedStyleType: \"HEADING_1\" },\n    fields: \"namedStyleType\"\n  }\n});\ncursor += title.length + 1;\n\n// Insert Description\nrequests.push({\n  insertText: {\n    location: { index: cursor },\n    text: description + '\\n'\n  }\n});\nrequests.push({\n  updateParagraphStyle: {\n    range: {\n      startIndex: cursor,\n      endIndex: cursor + description.length + 1,\n    },\n    paragraphStyle: { namedStyleType: \"HEADING_2\" },\n    fields: \"namedStyleType\"\n  }\n});\ncursor += description.length + 1;\n\n// Insert Article Heading\nconst articleHeading = 'Article';\nrequests.push({\n  insertText: {\n    location: { index: cursor },\n    text: articleHeading + '\\n'\n  }\n});\nrequests.push({\n  updateParagraphStyle: {\n    range: {\n      startIndex: cursor,\n      endIndex: cursor + articleHeading.length + 1\n    },\n    paragraphStyle: { namedStyleType: \"HEADING_2\" },\n    fields: \"namedStyleType\"\n  }\n});\ncursor += articleHeading.length + 1;\n\n// Insert Article Content\nrequests.push({\n  insertText: {\n    location: { index: cursor },\n    text: article\n  }\n});\n\nreturn [{ \n  json:{\n  payload:{\n    requests\n  }\n}\n  }\n];\n"
      },
