    {
      "parameters": {
        "jsCode": "const item = $input.all()\nlet nearestDiff = Infinity;\nlet nearestRow = null;\nconst now = new Date();\n\nfor(const row of item){\n  \nconst rowTime = new Date(`${row.json.Date} ${row.json.Time}`)\n  const diff = Math.floor((rowTime - now) / 1000);\n\n    if(diff > 0 && diff < nearestDiff){\n      nearestDiff = diff\n      nearestRow = row\n    }\n}\n\nreturn [{\n  json:{\n    seconds: Math.floor(nearestDiff),\n    topic: nearestRow.json.Topic,\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
