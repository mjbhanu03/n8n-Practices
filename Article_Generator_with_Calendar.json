    {
      "parameters": {
        "jsCode": "let events = $input.first()\nlet events3 = events.json.events\nlet nearestEvent = null;\nlet nearestDiff = Infinity;\nlet havingEvent = false;\n\nconst now = new Date()\nlet time = []\nfor(const event of events3){\n  const startTime = new Date(event.time)\n  var diff = (startTime - now) / 1000;\n  time.push(diff)\n  if(diff > 0 && diff < nearestDiff){\n    nearestDiff = diff;\n    nearestEvent = event;\n    havingEvent = true\n  }\n}\n\nreturn [{\n  json:{\n    // topic: nearestEvent.json.summary,\n    time: time,\n    nearestDiff: Math.floor(nearestDiff),\n    nearestEvent: nearestEvent,\n    event: havingEvent\n    // time: Math.ceil(diff),\n    // events3\n  }\n}]"
      },
