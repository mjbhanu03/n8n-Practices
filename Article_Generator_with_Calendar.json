      "parameters": {
        "jsCode": "let items = $input.all()\nlet events = [];\nfor(const item of items){\n  let event = {\n  topic: item.json.summary,\n  time: item.json.start.dateTime\n  }  \n  events.push(event)\n}\nreturn[{\n  json:{\n    events}\n}]"
